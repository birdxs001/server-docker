ARG NODE_VERSION=14
FROM node:${NODE_VERSION}

ARG VERSION=master
ARG BUILD=desktop

LABEL com.stremio.vendor="Smart Code Ltd."
LABEL version=${VERSION}
LABEL description="Stremio's streaming Server"

SHELL ["/bin/sh", "-c"]
CMD ["bash"]
WORKDIR /stremio

# 安装依赖：wget, gnupg, 以及 VA-API 驱动
RUN apt update && apt install -y \
    wget \
    gnupg \
    libva2 \
    va-driver-all \
    intel-media-va-driver \
    && rm -rf /var/lib/apt/lists/*

# 添加 Jellyfin 官方 APT 仓库（自动解决依赖）
RUN wget -O /usr/share/keyrings/jellyfin.gpg https://repo.jellyfin.org/ubuntu/jellyfin.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/$(awk -F'=' '/^ID=/{ print $2 }' /etc/os-release) $(awk -F'=' '/^VERSION_CODENAME=/{ print $2 }' /etc/os-release) main" > /etc/apt/sources.list.d/jellyfin.list \
    && apt update \
    && apt install -y jellyfin-ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY download_server.sh download_server.sh
RUN ./download_server.sh

COPY . .

VOLUME ["/root/.stremio-server"]

EXPOSE 11470
EXPOSE 12470

ENV FFMPEG_BIN=/usr/lib/jellyfin-ffmpeg/ffmpeg
ENV FFPROBE_BIN=/usr/lib/jellyfin-ffmpeg/ffprobe
ENV APP_PATH=
ENV NO_CORS=
ENV CASTING_DISABLED=1

ENTRYPOINT [ "node", "server.js" ]
